package components

templ SidebarHeader() {
	<div class="px-2">
		<div class="flex flex-wrap items-center gap-2">
			<div class="w-16 h-16 flex items-center justify-center">
				<div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
					<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
						<path d="M2 4.75A2.75 2.75 0 014.75 2h10.5A2.75 2.75 0 0118 4.75v10.5A2.75 2.75 0 0115.25 18H4.75A2.75 2.75 0 012 15.25V4.75z"/>
					</svg>
				</div>
			</div>
			<div class="flex-1 [#sidebar-toggle:checked~*_&]:hidden">
				<div class="text-lg font-semibold whitespace-nowrap">Cubework</div>
				<div class="text-sm text-gray-400 whitespace-nowrap">Parking Admin</div>
			</div>
			<label for="sidebar-toggle" class="cursor-pointer p-2 hover:bg-gray-700 rounded-lg basis-full [#sidebar-toggle:not(:checked)~*_&]:basis-auto [#sidebar-toggle:checked~*_&]:flex [#sidebar-toggle:checked~*_&]:justify-center" x-data @click="document.querySelectorAll('.menu-item-checkbox').forEach(checkbox => checkbox.checked = false);">
				<svg class="w-5 h-5 transition-transform duration-200 [#sidebar-toggle:checked~*_&]:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
				</svg>
			</label>
		</div>
	</div>
}
